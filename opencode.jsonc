{
  "$schema": "https://opencode.ai/config.json",
  // "model": "",
  "default_agent": "tech-lead",
  // "update": "disable",
  // "username": "Pikachu",
  "policies": [
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "huggingface",
      "effect": "deny"
    },
    {
      "action": "skill.use",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "formatter": true,
  "websearch": {
    "provider": "exa"
  },
  "experimental": {
    "subagent_depth": 2,
    "todo": true,
  },
  "agents": {
    "plan": {
      "disabled": true
    },
    "build": {
      "disabled": true
    },
    "general": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "title": {
      // "model": ""
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "todowrite",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "doom_loop",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp",
        "headers": {
          "x-api-key": "{env:EXA_API_KEY}"
        }
      },
    }
  },
  "providers": {
    // your custom provider configuration goes here
    // particularly helpful to add and configure specific models
    // as of now, opencode does not automatically detect models
    // lookup specifics from http://endpoint/v1/models and https://models.dev/
  },
}
