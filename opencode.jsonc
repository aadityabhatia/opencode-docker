{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "subagent_depth": 2,
  "agent": {
    "plan": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "permission": {
    "external_directory": "deny",
    "skill": "deny",
    "read": "allow",
    "todowrite": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "doom_loop": "deny",
    "question": "deny"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-647a93ca-29f0-485c-8371-5a6473bfa3a1"
      }
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "0d5d4456-3a6b-4cb2-944e-e167314c6d98"
      }
    }
  },
  "provider": {
    // your custom provider configuration goes here
    // particularly helpful to add and configure specific models
    // as of now, opencode does not automatically detect models
    // lookup specifics from http://endpoint/v1/models and https://models.dev/
  },
  "disabled_providers": ["opencode"]
}
